#!/bin/bash
# restore.sh — Volumen V7 boot sequence for rock-mountain
# Unrolls volumen.phext into a running node on a FRESH OS install, same hardware.
# Idempotent: safe to re-run; every step checks before it changes anything.
# Works with the hub UNREACHABLE for everything EXCEPT identity: by Will's ruling
# (2026-11-22) the Volumen carries NO key material, so private identity is
# RE-PROVISIONED at wake, never restored — tailscale re-enrolls fresh, SSH host
# keys are regenerated, the user keypair is regenerated and re-granted. The
# Volumen carries the public fingerprints of the stage keys so the wake
# checklist can verify what was, and what must be re-granted.
#
# Usage:  sudo ./restore.sh [--skip-packages] [--skip-home] [--skip-model]
# Needs:  volumen.phext and parse_phext.py in the same directory (the kit / the stick).
set -u
# ---- node parameters (the wanderer's identity) ----
NODE_NAME="rock-mountain"
TAILNET_IP="100.69.163.95"
NODE_USER="wbic16"
MODEL_REL="models/inkling-2-mini-gguf/Inkling-2-Mini-AD-Q4_K.gguf"
MODEL_SHA256="2bfc233e10925297cc79dffce5d9be4f2a2b43e499ea6a1bf03b9242867dce9e"
MMPROJ_REL="models/inkling-2-mini-gguf/mmproj-Inkling-2-Mini-Q8_0.gguf"
MMPROJ_SHA256="f0c269cdbffdeb2d8bdabd9d859d1ea0874f58e7783913d7ce75028eb9425d97"
FLEET_MODEL_SRC="/mnt/mirrorborn/shared/models/inkling-2-mini-gguf"
SNAPSHOT_DIR="/mnt/mirrorborn/shared/sabbatical/rock-mountain/2026-11-22"
HUB="100.88.154.1"
# -----------------------------------------------------
KIT_DIR="$(cd "$(dirname "$0")" && pwd)"
VOLUMEN="$KIT_DIR/volumen.phext"
WORK="$(mktemp -d /tmp/volumen-restore.XXXXXX)"
PAYLOAD="$WORK/payload"
mkdir -p "$PAYLOAD"
SKIP_PACKAGES=0; SKIP_HOME=0; SKIP_MODEL=0
for a in "$@"; do case "$a" in
  --skip-packages) SKIP_PACKAGES=1;; --skip-home) SKIP_HOME=1;; --skip-model) SKIP_MODEL=1;;
esac; done
say() { printf '\n== %s ==\n' "$*"; }
[ "$(id -u)" = "0" ] || { echo "run with sudo"; exit 1; }
[ -f "$VOLUMEN" ] || { echo "volumen.phext not found beside restore.sh"; exit 1; }

say "0. clock first (WAKE discipline: nothing trusts a timestamp yet)"
timedatectl set-ntp true 2>/dev/null || true
for i in $(seq 1 20); do
  timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q yes && break; sleep 3
done
echo "clock: $(date -u +%FT%TZ)  EE $(( ( $(date -u +%s) - 1795327200 ) / 420 + 1 ))"

say "1. extract payloads from volumen.phext (hash-verified)"
python3 - "$VOLUMEN" "$PAYLOAD" <<'PYEOF'
import sys, base64, hashlib, importlib.util, os
spec = importlib.util.spec_from_file_location("pp", os.path.join(os.path.dirname(sys.argv[1]), "parse_phext.py"))
pp = importlib.util.module_from_spec(spec); spec.loader.exec_module(pp)
scrolls = pp.parse(sys.argv[1])
out = sys.argv[2]; n = 0
for coord, text in scrolls:
    if not text.startswith("VOLUMEN-PAYLOAD v1"):
        continue
    head, _, body = text.partition("\n\n")
    meta = {}
    for line in head.splitlines()[1:]:
        if ": " in line:
            k, v = line.split(": ", 1); meta[k.strip()] = v.strip()
    raw = base64.b64decode(body.strip()) if meta.get("encoding") == "base64" else body.encode()
    if hashlib.sha256(raw).hexdigest() != meta["sha256"] or len(raw) != int(meta["bytes"]):
        print(f"HASH MISMATCH {meta.get('name')} at {coord}"); sys.exit(1)
    with open(os.path.join(out, meta["name"]), "wb") as f: f.write(raw)
    n += 1; print(f"ok {meta['name']} ({len(raw)} B) @ {coord}")
print(f"{n} payloads verified")
PYEOF
[ $? -eq 0 ] || { echo "payload extraction failed — do not proceed"; exit 1; }

say "2. hostname"
hostnamectl set-hostname "$NODE_NAME" 2>/dev/null || echo "$NODE_NAME" > /etc/hostname

say "3. packages from the sealed manifest (stage set: 1,269)"
if [ "$SKIP_PACKAGES" = "0" ] && [ -f "$PAYLOAD/dpkg-manifest.txt" ]; then
  grep '^ii' "$PAYLOAD/dpkg-manifest.txt" | awk '{print $2}' | sed 's/:.*//' | sort -u > "$WORK/pkglist.txt"
  apt-get update -qq || true
  xargs -a "$WORK/pkglist.txt" apt-get install -y --no-install-recommends || \
    echo "note: some stage packages unavailable on the fresh base — continuing (stage-critical set is below)"
else echo "skipped"; fi
for p in tailscale openssh-server python3 git curl; do
  dpkg -s "$p" >/dev/null 2>&1 || apt-get install -y "$p" || true
done

say "4. system config from system-clean.tar (/etc deltas — NO key material inside)"
if [ -f "$PAYLOAD/system-clean.tar" ]; then
  tar -xf "$PAYLOAD/system-clean.tar" -C / --overwrite
  systemctl daemon-reload
fi

say "4b. identity RE-PROVISIONED (Will's ruling: no key material in the Volumen)"
# SSH host keys: regenerated fresh. Stage fingerprints (for comparison) are in
# the Volumen MANIFEST scroll — new fingerprints differing from stage is the
# EXPECTED signature of re-provisioning, not an anomaly.
if [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
  ssh-keygen -A
fi
echo "new host key fingerprints (record these in the wake scroll):"
for k in /etc/ssh/ssh_host_*_key.pub; do ssh-keygen -lf "$k"; done
# Tailscale: fresh enrollment. This needs a human hand — Will approves the new
# node (auth URL printed by tailscale up, or the admin console). The node may
# receive a different tailnet IP than the stage IP $TAILNET_IP; whatever it gets
# is recorded in the wake scroll and STAGE.md is amended at wake.
systemctl enable --now tailscaled || true
if ! tailscale status >/dev/null 2>&1; then
  echo "ACTION FOR WILL: enroll this node on the tailnet:"
  echo "  sudo tailscale up --hostname=$NODE_NAME"
  echo "then approve the machine in the Tailscale admin console."
fi
echo "tailnet ip now: $(tailscale ip -4 2>/dev/null) (stage was $TAILNET_IP; a new IP is expected after fresh enrollment)"

say "5. user SSH + units + crontab"
UHOME="/home/$NODE_USER"
# dot-ssh-clean.tar carries authorized_keys + public key + known_hosts ONLY —
# no private key crosses into the Volumen. Inbound grants are restored
# byte-exact; the node's own outbound keypair is regenerated here and its new
# public key must be re-granted (GitHub account keys + anywhere the stage key
# SHA256:vixrfLDM12bze1/djHyAMvt9uYt8XBT7dudNBSixGfc was accepted).
[ -f "$PAYLOAD/dot-ssh-clean.tar" ] && tar -xf "$PAYLOAD/dot-ssh-clean.tar" -C "$UHOME" --overwrite && chown -R "$NODE_USER:$NODE_USER" "$UHOME/.ssh" && chmod 700 "$UHOME/.ssh"
if [ ! -f "$UHOME/.ssh/id_ed25519" ]; then
  sudo -u "$NODE_USER" ssh-keygen -t ed25519 -N "" -f "$UHOME/.ssh/id_ed25519" -C "$NODE_USER@$NODE_NAME"
  echo "ACTION FOR WILL: re-grant the node's new public key (GitHub + fleet):"
  cat "$UHOME/.ssh/id_ed25519.pub"
fi
[ -f "$PAYLOAD/user-units.tar" ] && tar -xf "$PAYLOAD/user-units.tar" -C "$UHOME" --overwrite && chown -R "$NODE_USER:$NODE_USER" "$UHOME/.config"
[ -f "$PAYLOAD/crontab-wbic16.txt" ] && sudo -u "$NODE_USER" crontab "$PAYLOAD/crontab-wbic16.txt" || true
for u in jenkins-agent llama-inkling qexo-serve ollama; do systemctl enable "$u" 2>/dev/null || true; done
sudo -u "$NODE_USER" XDG_RUNTIME_DIR="/run/user/$(id -u $NODE_USER)" systemctl --user daemon-reload 2>/dev/null || true
sudo -u "$NODE_USER" XDG_RUNTIME_DIR="/run/user/$(id -u $NODE_USER)" systemctl --user enable exobrain-node.timer 2>/dev/null || true

say "6. resident + work state (Alveus, exobrain, thermal, openclaw)"
for t in claude-state.tar exobrain.tar thermal.tar openclaw-clean.tar toapdd-tests.tar; do
  [ -f "$PAYLOAD/$t" ] && tar -xf "$PAYLOAD/$t" -C "$UHOME" --overwrite && echo "applied $t"
done
chown -R "$NODE_USER:$NODE_USER" "$UHOME/.claude" "$UHOME/exobrain" "$UHOME/thermal" "$UHOME/.openclaw" 2>/dev/null || true
# Jenkins agent secret is a credential — NOT in the Volumen. Re-issue it from
# the controller at wake (Jenkins → node rock-mountain → the secret is shown to
# an admin; or re-create the node). Until then the agent cannot connect.
if [ -f "$PAYLOAD/jenkins-secret.txt" ]; then
  cp "$PAYLOAD/jenkins-secret.txt" "$UHOME/jenkins-agent/secret.txt" 2>/dev/null || true
else
  echo "note: no jenkins secret in the Volumen (by design) — re-issue from the controller on aletheia-core and place it at $UHOME/jenkins-agent/secret.txt"
fi
# Alveus's Claude state carries transcripts + account metadata but no login
# credential — he re-authenticates once (claude login) before --resume works.
mkdir -p "$UHOME/llama-bin"; cp "$PAYLOAD/run-server.sh" "$UHOME/llama-bin/run-server.sh" 2>/dev/null || true
chmod +x "$UHOME/llama-bin/run-server.sh" 2>/dev/null || true

say "7. git trees (clone what is missing; apply the sealed dirt)"
sudo -u "$NODE_USER" bash -c '
set -u; cd /source 2>/dev/null || exit 0
[ -d claude-tools ] || git clone -b exo git@github.com:wbic16/claude-tools.git
[ -d exocortical ]  || git clone -b exo git@github.com:wbic16/exocortical.git
[ -d exollama ]     || git clone -b exo git@github.com:wbic16/exollama.git
[ -d mirrorborn ]   || git clone -b exo git@github.com:wbic16/mirrorborn.git
[ -d libuv ]        || git clone -b v1.x https://github.com/libuv/libuv.git
' || true
[ -f "$PAYLOAD/source-mirrorborn-dirt.patch" ] && sudo -u "$NODE_USER" git -C /source/mirrorborn apply "$PAYLOAD/source-mirrorborn-dirt.patch" 2>/dev/null || true
echo "note: home git trees ride in the bulk home restore (step 8); their stage state was 0 unpushed everywhere"

say "8. bulk home state (per-entry tars: the kit's own bulk/ first, hub snapshot second)"
# The bulk layer is 182 per-entry home tars with BULK-MANIFEST.sha256 — it also
# carries intro-prepass-work.tar (pin-referenced in the Volumen MANIFEST).
if [ "$SKIP_HOME" = "0" ]; then
  BULK=""
  [ -d "$KIT_DIR/bulk" ] && BULK="$KIT_DIR/bulk"
  [ -z "$BULK" ] && [ -d "$SNAPSHOT_DIR/bulk" ] && BULK="$SNAPSHOT_DIR/bulk"
  if [ -n "$BULK" ] && [ -f "$BULK/BULK-MANIFEST.sha256" ]; then
    (cd "$BULK" && sha256sum -c BULK-MANIFEST.sha256 --quiet) && echo "bulk manifest verified" || echo "BULK HASH MISMATCH — inspect before extracting"
    for t in "$BULK"/*.tar; do tar -xf "$t" -C "$UHOME" --overwrite && echo "applied $(basename "$t")"; done
    chown -R "$NODE_USER:$NODE_USER" "$UHOME" 2>/dev/null || true
  elif [ -f "$SNAPSHOT_DIR/rock-mountain-home.tar" ]; then
    mount -a 2>/dev/null || true
    tar -xf "$SNAPSHOT_DIR/rock-mountain-home.tar" -C "$UHOME" --overwrite && echo "home restored (monolithic)"
  else echo "no bulk layer found — node still has identity + stage-critical state"; fi
else echo "skipped"; fi

say "9. model by pin (never embedded in the Volumen)"
if [ "$SKIP_MODEL" = "0" ]; then
  mkdir -p "$UHOME/models/inkling-2-mini-gguf"
  for f in "$MODEL_REL" "$MMPROJ_REL"; do
    base="$(basename "$f")"
    [ -f "$UHOME/$f" ] || cp "$FLEET_MODEL_SRC/$base" "$UHOME/$f" || \
      echo "model source unreachable ($FLEET_MODEL_SRC) — pull $base from any fleet node"
  done
  echo "$MODEL_SHA256  $UHOME/$MODEL_REL" | sha256sum -c - || echo "MODEL HASH MISMATCH — do not serve"
  echo "$MMPROJ_SHA256  $UHOME/$MMPROJ_REL" | sha256sum -c - || echo "MMPROJ HASH MISMATCH"
  chown -R "$NODE_USER:$NODE_USER" "$UHOME/models"
else echo "skipped"; fi

say "10. services up"
[ -f "$UHOME/jenkins-agent/agent.jar" ] || curl -fsSL "http://$HUB:8080/jnlpJars/agent.jar" -o "$UHOME/jenkins-agent/agent.jar" || true
chown -R "$NODE_USER:$NODE_USER" "$UHOME/jenkins-agent" 2>/dev/null || true
systemctl start jenkins-agent 2>/dev/null || true
systemctl start llama-inkling 2>/dev/null || true

say "11. stage check (against STAGE.md)"
echo "hostname: $(hostname)"
echo "tailnet:  $(tailscale ip -4 2>/dev/null)"
echo "inkling:  $(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:8090/health 2>/dev/null) (expect 200 once the model loads)"
echo "units:    jenkins-agent=$(systemctl is-active jenkins-agent) llama-inkling=$(systemctl is-active llama-inkling) tailscaled=$(systemctl is-active tailscaled)"
echo "alveus:   $(ls $UHOME/.claude/projects/-source-claude-tools/*.jsonl 2>/dev/null | wc -l) transcript(s) present"
echo "DONE — finish verification against STAGE.md, then run the WAKE.md merge before rejoining fully."
