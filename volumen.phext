name: run-server.sh
encoding: text
sha256: b704a26c59f0690e349bb7aaad59a3c1f9855e519b37a70e5c96f3bf8b6d79b9
bytes: 623

#!/bin/bash
# Inkling-2-Mini llama-server launcher — reads serve.conf, execs the configured build.
CONF="$HOME/models/inkling-2-mini-gguf/serve.conf"
MODEL=Inkling-2-Mini-Q4_K_M.gguf; FLAVOR=vulkan; NGL=99; PORT=8090; CTX=8192
[ -f "$CONF" ] && . "$CONF"
BIN="$HOME/llama-bin/$FLAVOR/llama-server"
export LD_LIBRARY_PATH="$HOME/llama-bin/$FLAVOR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$BIN" \
  --model "$HOME/models/inkling-2-mini-gguf/$MODEL" \
  --mmproj "$HOME/models/inkling-2-mini-gguf/mmproj-Inkling-2-Mini-Q8_0.gguf" \
  --host 0.0.0.0 --port "$PORT" --ctx-size "$CTX" \
  --n-gpu-layers "$NGL" --parallel 1
