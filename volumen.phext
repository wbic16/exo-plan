#!/bin/bash
# make-bootable.sh — build the wanderer's stick for rock-mountain
# STATUS: scripted in drill pass 1 (2026-11-22), NOT yet test-booted. The honest
# artifact of this pass is the kit directory; this script turns it into a stick.
#
# Method: an Ubuntu Server install ISO's own tree is UEFI-bootable when copied to
# a FAT32 stick (it carries /EFI/BOOT/BOOTx64.efi). We copy the ISO tree, then add
# the kit (volumen.phext + restore.sh + parse_phext.py + docs) under /volumen/.
# Boot the stick -> install Ubuntu -> log in -> run /volumen/restore.sh from the stick.
#
# Usage: sudo ./make-bootable.sh /path/to/ubuntu-server.iso /dev/sdX   (DEVICE IS ERASED)
set -eu
ISO="${1:?usage: make-bootable.sh <ubuntu-server.iso> <device>}"
DEV="${2:?usage: make-bootable.sh <ubuntu-server.iso> <device>}"
KIT="$(cd "$(dirname "$0")" && pwd)"
[ "$(id -u)" = "0" ] || { echo "run with sudo"; exit 1; }
lsblk "$DEV"
printf 'ERASE %s and build the rock-mountain stick? [y/N] ' "$DEV"; read -r a
[ "$a" = "y" ] || { echo aborted; exit 1; }
parted -s "$DEV" mklabel gpt mkpart primary fat32 1MiB 100%
PART="${DEV}1"; [ -b "${DEV}p1" ] && PART="${DEV}p1"
mkfs.vfat -F 32 -n VOLUMEN "$PART"
MNT="$(mktemp -d)"; ISOMNT="$(mktemp -d)"
mount "$PART" "$MNT"; mount -o loop,ro "$ISO" "$ISOMNT"
cp -a "$ISOMNT"/. "$MNT"/
mkdir -p "$MNT/volumen"
cp -a "$KIT"/volumen.phext "$KIT"/restore.sh "$KIT"/parse_phext.py \
      "$KIT"/STAGE.md "$KIT"/WAKE.md "$KIT"/README-STICK.md "$MNT/volumen/"
sha256sum "$KIT/volumen.phext" > "$MNT/volumen/volumen.phext.sha256"
sync; umount "$MNT"; umount "$ISOMNT"
echo "stick built on $PART — label VOLUMEN. It lives with rock-mountain."
VOLUMEN-PAYLOAD v1
